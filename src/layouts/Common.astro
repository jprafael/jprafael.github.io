---
const { title = "Board Gamers Porto" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  body { font-family: system-ui, sans-serif; line-height: 1.6; margin: 0; }
  main { margin: 4rem auto; max-width: 42rem; padding: 0 1rem; }
</style>
