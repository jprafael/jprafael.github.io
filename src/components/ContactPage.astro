---
import Common from "../layouts/Common.astro";
import { messages, type Locale } from "../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
---

<Common title={messages[locale].contact} locale={locale}>
  <div class="heading">
    <p class="eyebrow">Boardgamers Porto</p>
    <h1 data-i18n data-pt={messages.pt.contact} data-en={messages.en.contact}>{messages.pt.contact}</h1>
    <p data-i18n data-pt={messages.pt.contactIntro} data-en={messages.en.contactIntro}>{messages.pt.contactIntro}</p>
  </div>

  <a class="whatsapp-notice" href="https://chat.whatsapp.com/Db4DUPSzbWTDuVjB8SLIhn" target="_blank" rel="noreferrer">
    <strong data-i18n data-pt={messages.pt.whatsappGroup} data-en={messages.en.whatsappGroup}>{messages.pt.whatsappGroup}</strong>
    <span data-i18n data-pt={messages.pt.contactWhatsappNote} data-en={messages.en.contactWhatsappNote}>{messages.pt.contactWhatsappNote}</span>
    <b aria-hidden="true">↗</b>
  </a>

  <div class="contact-list">
    <a href="mailto:geral@boardgamersporto.com">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
      <span class="details"><span data-i18n data-pt={messages.pt.email} data-en={messages.en.email}>{messages.pt.email}</span><strong>geral@boardgamersporto.com</strong></span>
    </a>
    <a href="https://www.facebook.com/BoardgamersPorto" target="_blank" rel="noreferrer">
      <svg class="filled" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V7c0-.8.5-1 1-1h2.8V2.1L14.4 2C10.9 2 9 4.1 9 7v1.5H6v4.4h3V22h5v-9.1h3.4l.6-4.4H14Z"/></svg>
      <span class="details"><span>Facebook</span><strong>BoardgamersPorto ↗</strong></span>
    </a>
    <a href="https://www.instagram.com/boardgamersporto/" target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.25"/><circle class="filled" cx="17.4" cy="6.7" r="1"/></svg>
      <span class="details"><span>Instagram</span><strong>@boardgamersporto ↗</strong></span>
    </a>
    <a href="https://boardgamegeek.com/profile/BoardgamersPorto" target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 21 7v10l-9 5-9-5V7l9-5Z"/><text x="12" y="15.1">BGG</text></svg>
      <span class="details"><span>BoardGameGeek</span><strong>BoardgamersPorto ↗</strong></span>
    </a>
    <a href="https://chat.whatsapp.com/Db4DUPSzbWTDuVjB8SLIhn" target="_blank" rel="noreferrer">
      <svg class="filled" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a11.8 11.8 0 0 0 5.6 1.4c6.5 0 11.7-5.3 11.7-11.8 0-3.2-1.2-6.1-3.5-8.4Zm-8.3 18.2c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.9-9.8a9.8 9.8 0 0 1 7 2.9 9.7 9.7 0 0 1 2.9 7c.1 5.4-4.3 9.8-9.8 9.8Zm5.4-7.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2-.2.3-.8.9-1 1.1-.2.2-.4.2-.7.1a8 8 0 0 1-2.3-1.4 8.7 8.7 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.2-.4-.4-.5-.7-.6Z"/></svg>
      <span class="details"><span data-i18n data-pt={messages.pt.whatsappGroup} data-en={messages.en.whatsappGroup}>{messages.pt.whatsappGroup}</span><strong>Boardgamers Porto ↗</strong></span>
    </a>
  </div>
</Common>

<style>
  .heading { border-bottom: 1px solid var(--line); margin-bottom: 2.5rem; max-width: 52rem; padding-bottom: 2rem; }
  .heading h1 { margin-bottom: 1.25rem; }
  .heading > p:last-child { color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); margin-bottom: 0; }
  .whatsapp-notice { align-items: center; background: var(--ink); border-radius: 1rem; color: white; display: grid; gap: .25rem 1.5rem; grid-template-columns: 1fr auto; margin-bottom: 1rem; padding: 1.5rem; text-decoration: none; }
  .whatsapp-notice strong { color: var(--gold); grid-column: 1; }
  .whatsapp-notice span { grid-column: 1; }
  .whatsapp-notice b { font-size: 1.5rem; grid-column: 2; grid-row: 1 / 3; }
  .whatsapp-notice:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .contact-list { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .contact-list a { align-items: center; border: 1px solid var(--line); border-radius: 1rem; display: flex; gap: 1rem; padding: 1.5rem; text-decoration: none; transition: border-color .2s, transform .2s; }
  .contact-list a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .contact-list a:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .contact-list svg { fill: none; flex: 0 0 auto; height: 2rem; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; width: 2rem; }
  .contact-list svg.filled, .contact-list svg .filled { fill: currentColor; stroke: none; }
  .contact-list svg text { fill: currentColor; font-size: 5.2px; font-weight: 800; stroke: none; text-anchor: middle; }
  .contact-list .details { display: flex; flex-direction: column; min-width: 0; }
  .contact-list .details > span { color: var(--muted); font-size: .8rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .contact-list strong { overflow-wrap: anywhere; }
  @media (max-width: 680px) { .contact-list { grid-template-columns: 1fr; } }
</style>
